<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="DatePicker">
        <Setter Property="Foreground" Value="#DCE2E6"/>
        <Setter Property="Background" Value="#101416"/>
        <Setter Property="BorderBrush" Value="#30393D"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid x:Name="PART_Root">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox" Foreground="{TemplateBinding Foreground}" Background="Transparent" Padding="10,8" BorderThickness="0">
                                    <DatePickerTextBox.Template>
                                        <ControlTemplate TargetType="DatePickerTextBox">
                                            <Grid Background="Transparent">
                                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                                <TextBlock x:Name="Hint" Text="날짜 선택" Foreground="#8D9AA1" Margin="10,8" IsHitTestVisible="False" Visibility="Collapsed"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </DatePickerTextBox.Template>
                                </DatePickerTextBox>
                                <Button x:Name="PART_Button" Grid.Column="1" Content="▦" Margin="2" Padding="4" Focusable="False" ToolTip="달력 표시"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="DialogFrame" TargetType="Window">
        <Border Background="#080A0B" BorderBrush="#343B3E" BorderThickness="1" CornerRadius="8">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="60">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                    <Thumb x:Name="DialogDrag" Cursor="SizeAll">
                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
                    </Thumb>
                    <StackPanel Margin="24,12,0,0" IsHitTestVisible="False">
                        <TextBlock Text="~/workspace" Foreground="#81948A" FontFamily="Cascadia Mono, Consolas" FontSize="10"/>
                        <TextBlock Text="{TemplateBinding Title}" Foreground="#DEE5E1" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="DialogClose" Grid.Column="1" Content="×" FontSize="20" Margin="4,10,10,10" ToolTip="닫기"/>
                </Grid>
                <Border BorderBrush="#242A2D" BorderThickness="0,1,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentPresenter/>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Border>
    </ControlTemplate>
</ResourceDictionary>
